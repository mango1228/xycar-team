<launch>

    <!-- 사용법: roslaunch my_lidar lidar_view.launch x:=0.5 y_max:=2.0 (생략 시 기본값 사용) -->
    <arg name="offset" default="-4.0"  />  <!-- 각도 보정 (도) -->
    <arg name="x"      default="0.2"   />  <!-- ROI 좌우 반폭 (±x m) -->
    <arg name="y_min"  default="-0.6"  />  <!-- ROI 시작 (m) -->
    <arg name="y_max"  default="-0.1"  />  <!-- ROI 끝 (m) -->

    <!-- LiDAR 드라이버 (xycar_ws의 xycar_lidar 패키지) -->
    <include file="$(find xycar_lidar)/launch/lidar_noviewer.launch" />

    <node name="scan_corrector" pkg="my_lidar" type="scan_corrector.py" output="screen">
        <param name="angle_offset_deg" value="$(arg offset)" />
        <param name="roi_x_min"        value="-$(arg x)"     />
        <param name="roi_x_max"        value="$(arg x)"      />
        <param name="roi_y_min"        value="$(arg y_min)"  />
        <param name="roi_y_max"        value="$(arg y_max)"  />
    </node>

    <!-- RViz: /scan_corrected 시각화 -->
    <node name="rviz_lidar" pkg="rviz" type="rviz"
          args="-d $(find my_lidar)/rviz/lidar_view.rviz"
          output="screen" />

</launch>
