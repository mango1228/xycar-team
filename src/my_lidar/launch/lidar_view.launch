<launch>

    <!-- LiDAR 드라이버 (xycar_ws의 xycar_lidar 패키지) -->
    <include file="$(find xycar_lidar)/launch/lidar_noviewer.launch" />

    <!-- 각도 오프셋 보정 노드: /scan -> /scan_corrected
         angle_offset_deg: 정면 장애물이 오른쪽으로 치우치면 음수, 왼쪽이면 양수 -->
    <node name="scan_corrector" pkg="my_lidar" type="scan_corrector.py" output="screen">
        <param name="angle_offset_deg" value="0.0" />
    </node>

    <!-- RViz: /scan_corrected 시각화 -->
    <node name="rviz_lidar" pkg="rviz" type="rviz"
          args="-d $(find my_lidar)/rviz/lidar_view.rviz"
          output="screen" />

</launch>
